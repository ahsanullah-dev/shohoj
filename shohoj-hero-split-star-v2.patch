+/* ── Split ticket: left half = segment, right half = its post ───────────── */
+.ticket-split {
+  padding: 0;
+  flex-direction: row;
+  cursor: default;
+}
+.ticket-split:hover {
+  border-color: var(--line-bright);
+}
+.ticket-half {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  gap: 6px;
+  padding: 16px 14px;
+  cursor: pointer;
+  transition: background 0.2s var(--ease);
+}
+.ticket-half:hover {
+  background: rgba(255, 255, 255, 0.03);
+}
+.ticket-half:focus-visible {
+  outline: 2px solid var(--accent, var(--amber));
+  outline-offset: -2px;
+}
+.ticket-seg {
+  text-align: right;
+  align-items: flex-end;
+  border-top: 3px solid var(--accent, var(--amber));
+  padding-right: 24px;
+}
+.ticket-post {
+  border-top: 3px solid var(--teal);
+  padding-left: 24px;
+}
+.ticket-divider {
+  width: 0;
+  border-left: 2px dashed var(--line-bright);
+  position: relative;
+  flex-shrink: 0;
+}
+.ticket-divider::before, .ticket-divider::after {
+  content: "";
+  position: absolute;
+  left: 50%;
+  width: 14px;
+  height: 14px;
+  background: var(--ink);
+  border-radius: 50%;
+  transform: translateX(-50%);
+}
+.ticket-divider::before { top: -7px; }
+.ticket-divider::after  { bottom: -7px; }
+.page-icon {
+  font-size: 24px;
+  line-height: 1;
+}
+.page-seg-name {
+  font-family: 'Space Grotesk', sans-serif;
+  font-weight: 700;
+  font-size: 15px;
+  line-height: 1.25;
+}
+.page-seg-cta, .page-post-cta {
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 10px;
+  color: var(--amber);
+}
+.page-post-badge {
+  align-self: flex-start;
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 9.5px;
+  font-weight: 700;
+  letter-spacing: 0.05em;
+  padding: 2px 7px;
+  border-radius: 5px;
+  border: 1.5px solid var(--teal);
+  color: var(--teal);
+  background: var(--teal-dim);
+  text-transform: uppercase;
+}
+.page-post-title {
+  font-family: 'Space Grotesk', sans-serif;
+  font-weight: 600;
+  font-size: 12.5px;
+  line-height: 1.3;
+  display: -webkit-box;
+  -webkit-line-clamp: 3;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.page-post-price {
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 12px;
+  color: var(--muted);
+}
