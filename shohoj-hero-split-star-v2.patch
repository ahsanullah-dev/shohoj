+
+      function cardHtml(seg, post, angle, accent) {
+        const title = post ? esc(post.title) : 'No posts yet';
+        const price = post && post.price != null ? fmtBDT(post.price) : '';
+        return `
+          <div class="ticket ticket-split" style="--accent:${accent}; transform:rotateY(${angle}deg) translateZ(10px);">
+            <div class="ticket-half ticket-seg" data-nav="feed.html?segment=${seg.key}" role="link" tabindex="0" aria-label="Browse ${esc(seg.name)}">
+              <div class="page-icon">${seg.icon}</div>
+              <div class="page-seg-name">${esc(seg.name)}</div>
+              <div class="page-seg-cta">Explore →</div>
+            </div>
+            <div class="ticket-divider"></div>
+            <div class="ticket-half ticket-post" data-nav="${post ? 'post.html?id=' + post._id : 'feed.html?segment=' + seg.key + '&new=1'}" role="link" tabindex="0" aria-label="${post ? esc(post.title) : 'Post something here'}">
+              <div class="page-post-badge">${post ? esc(seg.name) : 'OPEN'}</div>
+              <div class="page-post-title">${title}</div>
+              ${price ? `<div class="page-post-price">${price}</div>` : `<div class="page-post-cta">Be the first to post →</div>`}
+            </div>
+          </div>`;
+      }
+
+      function render(cycle) {
+        const n = cycle.length;
+        stack.innerHTML = cycle.map((c, i) =>
+          cardHtml(c.seg, c.post, Math.round((360 / n) * i), accents[i % accents.length])
+        ).join('');
+        stack.querySelectorAll('.ticket-half').forEach((el) => {
+          const go = () => { location.href = el.dataset.nav; };
+          el.addEventListener('click', go);
+          el.addEventListener('keydown', (e) => {
+            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
+          });
+        });
+      }
+
+      async function init() {
+        let cycle;
+        try {
+          const { posts } = await API.get('/api/posts?limit=40');
+          const bySegment = {};
+
+          (posts || []).forEach((p) => { if (!bySegment[p.segment]) bySegment[p.segment] = p; });
+          const anyPost = (posts && posts[0]) || null;
+          cycle = SEGMENTS.map((seg) => ({ seg, post: bySegment[seg.key] || anyPost }));
+        } catch {
+          cycle = SEGMENTS.map((seg) => ({ seg, post: null }));
+        }
+        render(cycle);
+      }
+      init();
