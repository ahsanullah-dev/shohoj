# --- Server ---
PORT=5000
# Comma-separated list of frontend origins allowed by CORS.
# For local dev, include your static server origin(s).
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:8080

# --- Database ---
# Get this from MongoDB Atlas → Connect → Drivers → Node.js
# Remember to add /shohoj before the '?' so it uses the "shohoj" database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shohoj?retryWrites=true&w=majority

# --- Auth ---
# Any long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# --- Email verification (Brevo / SendGrid — works on Render free tier) ---
# Render's free tier blocks outbound SMTP (ports 25/465/587), so Gmail SMTP
# below will always time out in production there. Brevo & SendGrid use HTTPS instead.

# Option A: Brevo (Recommended — 300 free emails/day, no domain needed)
# 1. Sign up free at https://www.brevo.com with your Gmail address.
# 2. Top right menu -> SMTP & API -> API Keys -> Generate a new API key.
# 3. Paste below:
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=youraddress@gmail.com
BREVO_SENDER_NAME=Shohoj

# Option B: SendGrid (100 free emails/day, no domain needed)
# 1. Sign up free at https://signup.sendgrid.com
# 2. Settings -> Sender Authentication -> Verify a Single Sender (your Gmail).
# 3. Settings -> API Keys -> Create API Key (Full Access) -> paste below:
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=youraddress@gmail.com

# --- Email verification (Gmail SMTP — local dev fallback only) ---
# Works when running the backend on your own machine. Does NOT work on
# Render's free tier (see above) -- kept as a fallback for local testing.
# Use any Gmail account. Turn on 2-Step Verification, then create an
# "App Password" at https://myaccount.google.com/apppasswords and paste
# the 16-character code below (NOT your normal Gmail password).
EMAIL_USER=youraddress@gmail.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- "Continue with Google" (Google Identity Services — free, no cost ever) ---
# Create at https://console.cloud.google.com/apis/credentials
# -> Create Credentials -> OAuth client ID -> Web application
# -> Authorized JavaScript origins: your Netlify URL + http://localhost:3000
GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# --- RUET auto-tag ---
# Comma-separated email domains that automatically get a "RUET-verified" tag on signup.
RUET_EMAIL_DOMAINS=student.ruet.ac.bd,ruet.ac.bd

# --- Cloudinary (real image uploads) ---
# Sign up free at https://cloudinary.com and copy from your dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Payments (manual bKash / Nagad "Send Money" verification) ---
# These are shown to buyers so they know where to Send Money.
# Real bKash/Nagad merchant APIs require business registration; this manual flow
# works with a personal Send Money number today and can be upgraded later.
PAYMENT_BKASH_NUMBER=017XXXXXXXX
PAYMENT_NAGAD_NUMBER=017XXXXXXXX
PAYMENT_INSTRUCTIONS=Open bKash/Nagad app → Send Money → paste the number → enter amount → note the Transaction ID and submit it here.
