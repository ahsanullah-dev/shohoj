# --- Server ---
PORT=5000
# Comma-separated list of frontend origins allowed by CORS.
# For local dev, include your static server origin(s).
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:8080

# --- Database ---
# Get this from MongoDB Atlas → Connect → Drivers → Node.js
# Remember to add /shohoj before the '?' so it uses the "shohoj" database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shohoj?retryWrites=true&w=majority

# --- Auth ---
# Any long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# --- RUET auto-tag ---
# Comma-separated email domains that automatically get a "RUET-verified" tag on signup.
RUET_EMAIL_DOMAINS=student.ruet.ac.bd,ruet.ac.bd

# --- Cloudinary (real image uploads) ---
# Sign up free at https://cloudinary.com and copy from your dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Payments (manual bKash / Nagad "Send Money" verification) ---
# These are shown to buyers so they know where to Send Money.
# Real bKash/Nagad merchant APIs require business registration; this manual flow
# works with a personal Send Money number today and can be upgraded later.
PAYMENT_BKASH_NUMBER=017XXXXXXXX
PAYMENT_NAGAD_NUMBER=017XXXXXXXX
PAYMENT_INSTRUCTIONS=Open bKash/Nagad app → Send Money → paste the number → enter amount → note the Transaction ID and submit it here.
